doctype html
html
  head
    title Registro - Fotaza2

    link(
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
    )

  body.bg-light

    .container.mt-5

      .row.justify-content-center

        .col-md-6

          .card.shadow

            .card-header.text-center
              h2 Registro de Usuario

            .card-body

              form(
                action="/auth/register"
                method="POST"
              )

                .mb-3
                  label.form-label Nombre

                  input.form-control(
                    type="text"
                    name="nombre"
                    required
                  )

                .mb-3
                  label.form-label Email

                  input.form-control(
                    type="email"
                    name="email"
                    required
                  )

                .mb-3
                  label.form-label Contraseña

                  input.form-control(
                    type="password"
                    name="password"
                    required
                  )

                button.btn.btn-success.w-100(
                  type="submit"
                )
                  | Registrarse

                br
                br

                a(
                  href="/auth/login"
                  class="btn btn-primary w-100"
                )
                  | Ya tengo una cuenta