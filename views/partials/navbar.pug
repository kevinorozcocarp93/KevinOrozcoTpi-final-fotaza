nav.navbar.navbar-expand-lg.navbar-dark.bg-dark.fixed-top

  .container

    a.navbar-brand(
      href="/posts"
    )
      | 📸 Fotaza

    button.navbar-toggler(
      type="button"
      data-bs-toggle="collapse"
      data-bs-target="#navbarNav"
    )

      span.navbar-toggler-icon

    .collapse.navbar-collapse#navbarNav

      ul.navbar-nav.me-auto

        li.nav-item

          a.nav-link(
            href="/posts"
          )
            | Feed

        li.nav-item

          a.nav-link(
            href="/posts/mis-posts"
          )
            | Mis Publicaciones

        li.nav-item

          a.nav-link(
            href="/usuarios/perfil"
          )
            | Perfil

        li.nav-item

          a.nav-link(
            href="/notificaciones"
          )

            if cantidadNotificaciones > 0

              | 🔔 Notificaciones (#{cantidadNotificaciones})

            else

              | 🔔 Notificaciones

      form.d-flex.me-3(
        action="/search"
        method="GET"
      )

        input.form-control.me-2(
          type="search"
          name="q"
          placeholder="Buscar usuarios o publicaciones"
          required
        )

        button.btn.btn-outline-light(
          type="submit"
        )
          | Buscar

      ul.navbar-nav

        li.nav-item

          a.nav-link.text-warning(
            href="/auth/logout"
          )
            | Cerrar Sesión