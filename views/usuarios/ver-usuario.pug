doctype html
html
  head
    title Usuario - Fotaza2

    link(
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
    )

  body.bg-light

    include ../partials/navbar

    .container.mt-5.pt-5

      .card.shadow.mb-4

        .card-body

          h2= usuario.nombre

          p
            strong Email:
            |  #{usuario.email}

          hr

          p
            strong Seguidores:
            |  #{cantidadSeguidores}

          p
            strong Siguiendo:
            |  #{cantidadSiguiendo}

          if usuario.id !== usuarioLogueado.id

            if yaLoSigo

              form(
                action=`/follow/unfollow/${usuario.id}`
                method="POST"
              )

                button.btn.btn-danger(
                  type="submit"
                )
                  | Dejar de seguir

            else

              form(
                action=`/follow/${usuario.id}`
                method="POST"
              )

                button.btn.btn-primary(
                  type="submit"
                )
                  | Seguir

      h3.mb-4 Publicaciones

      if publicaciones.length > 0

        each post in publicaciones

          .card.mb-4.shadow-sm

            .card-body

              h4= post.titulo

              p= post.descripcion

              if post.imagen

                img.rounded.mb-3.w-100(
                  src=`/uploads/${post.imagen}`
                  style="height:500px; object-fit:cover;"
                )

              p.fw-bold.text-primary
                | 👍 #{post.Likes.length} Me gusta

      else

        .alert.alert-info

          | Este usuario todavía no tiene publicaciones.

    script(
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
    )