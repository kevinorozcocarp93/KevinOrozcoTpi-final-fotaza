doctype html
html
  head
    title Usuario

    link(
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
    )

  body.bg-light

    include ../partials/navbar

    .container.mt-5.pt-5

      .card.shadow

        .card-body

          h2= usuario.nombre

          p
            strong Email:
            |  #{usuario.email}

          hr

          p
            strong Seguidores:
            |  #{cantidadSeguidores}

          p
            strong Siguiendo:
            |  #{cantidadSiguiendo}

          if usuario.id !== usuarioLogueado.id

            if yaLoSigo

              button.btn.btn-secondary(disabled)
                | Ya lo sigues

            else

              form(
                action=`/follow/${usuario.id}`
                method="POST"
              )

                button.btn.btn-primary(
                  type="submit"
                )
                  | Seguir