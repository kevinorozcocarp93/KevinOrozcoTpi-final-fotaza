doctype html
html
  head
    title Editar Perfil - Fotaza2

    link(
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
    )

  body.bg-light

    include ../partials/navbar

    .container.mt-5.pt-5

      .card.shadow

        .card-body

          h2.mb-4 Editar Perfil

          form(
            action="/usuarios/editar"
            method="POST"
            enctype="multipart/form-data"
          )

            .mb-3

              label.form-label Nombre

              input.form-control(
                type="text"
                name="nombre"
                value=usuario.nombre
                required
              )

            .mb-3

              label.form-label Biografía

              textarea.form-control(
                name="bio"
                rows="5"
              )= usuario.bio

            .mb-3

              label.form-label Foto de Perfil

              input.form-control(
                type="file"
                name="foto_perfil"
                accept="image/*"
              )

            if usuario.foto_perfil

              .mb-3

                p Foto actual:

                img.rounded-circle(
                  src=`/uploads/${usuario.foto_perfil}`
                  width="150"
                  height="150"
                  style="object-fit:cover;"
                )

            button.btn.btn-success(
              type="submit"
            )
              | Guardar Cambios

            a.btn.btn-secondary.ms-2(
              href="/usuarios/perfil"
            )
              | Cancelar