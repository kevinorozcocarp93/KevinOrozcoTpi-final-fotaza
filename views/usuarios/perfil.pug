doctype html
html
  head
    title Perfil de Usuario

  body

    h1 Perfil de Usuario

    hr

    p
      strong Nombre:
      |  #{usuario.nombre}

    p
      strong Email:
      |  #{usuario.email}

    p
      strong Rol:
      |  #{usuario.rol_id}

    hr

    h2 Estadísticas

    p
      strong Publicaciones creadas:
      |  #{cantidadPosts}

    p
      strong Comentarios realizados:
      |  #{cantidadComentarios}

    p
      strong Likes realizados:
      |  #{cantidadLikes}

    hr

    a(href="/posts")
      | Ver Feed General

    br
    br

    a(href="/posts/mis-posts")
      | Mis Publicaciones

    br
    br

    a(href="/auth/logout")
      | Cerrar Sesión