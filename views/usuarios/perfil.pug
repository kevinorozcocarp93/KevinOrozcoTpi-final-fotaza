doctype html
html
  head
    title Perfil - Fotaza2

    link(
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
    )

  body.bg-light

    include ../partials/navbar

    .container.mt-5.pt-5

      .row.justify-content-center

        .col-md-8

          .card.shadow

            .card-header.bg-primary.text-white

              .d-flex.justify-content-between.align-items-center

                h2.mb-0 Perfil de Usuario

                a.btn.btn-warning.btn-sm(
                  href="/usuarios/editar"
                )
                  | Editar Perfil

            .card-body.text-center

              h4 Información Personal

              if usuario.foto_perfil

                img.rounded-circle.mb-3(
                  src=usuario.foto_perfil
                  width="180"
                  height="180"
                  style="object-fit:cover;"
                )

              else

                img.rounded-circle.mb-3(
                  src="https://via.placeholder.com/180"
                  width="180"
                  height="180"
                )

              p
                strong Nombre:
                |  #{usuario.nombre}

              p
                strong Email:
                |  #{usuario.email}

              p
                strong Rol:
                |  #{nombreRol}

              p
                strong Biografía:

              if usuario.bio

                p.text-muted
                  = usuario.bio

              else

                p.text-muted
                  | Todavía no has agregado una biografía.

              hr

              h4 Estadísticas

              .row.text-center

                .col-md-4

                  .card.border-primary.mb-3

                    .card-body

                      h2.text-primary= cantidadPosts

                      p Publicaciones

                .col-md-4

                  .card.border-success.mb-3

                    .card-body

                      h2.text-success= cantidadComentarios

                      p Comentarios

                .col-md-4

                  .card.border-warning.mb-3

                    .card-body

                      h2.text-warning= cantidadLikes

                      p Likes

    script(
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
    )