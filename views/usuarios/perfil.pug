doctype html
html
  head
    title Perfil - Fotaza2

    link(
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
    )

  body.bg-light

    .container.mt-5

      .row.justify-content-center

        .col-md-8

          .card.shadow

            .card-header.bg-primary.text-white

              h2.mb-0 Perfil de Usuario

            .card-body

              h4 Información Personal

              p
                strong Nombre:
                |  #{usuario.nombre}

              p
                strong Email:
                |  #{usuario.email}

              p
                strong Rol:
                |  #{usuario.rol_id}

              hr

              h4 Estadísticas

              .row.text-center

                .col-md-4

                  .card.border-primary.mb-3

                    .card-body

                      h2.text-primary= cantidadPosts

                      p Publicaciones

                .col-md-4

                  .card.border-success.mb-3

                    .card-body

                      h2.text-success= cantidadComentarios

                      p Comentarios

                .col-md-4

                  .card.border-warning.mb-3

                    .card-body

                      h2.text-warning= cantidadLikes

                      p Likes

              hr

              .d-flex.gap-2.flex-wrap

                a.btn.btn-primary(
                  href="/posts"
                )
                  | Feed General

                a.btn.btn-success(
                  href="/posts/mis-posts"
                )
                  | Mis Publicaciones

                a.btn.btn-danger(
                  href="/auth/logout"
                )
                  | Cerrar Sesión