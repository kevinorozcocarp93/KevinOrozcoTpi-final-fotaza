doctype html
html
  head
    title Fotaza2

    link(
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
    )

  body.bg-dark.text-light

    .container.mt-5

      .text-center.mb-5

        h1.display-3.fw-bold
          | 📸 Fotaza

        p.lead
          | Red social para compartir publicaciones e imágenes.

      .card.bg-secondary.text-light.shadow-lg

        .card-body.p-5

          h3.mb-4.text-center
            | Accesos

          .d-grid.gap-3

            a.btn.btn-success.btn-lg(
              href="/auth/register"
            )
              | Registrarse

            a.btn.btn-primary.btn-lg(
              href="/auth/login"
            )
              | Iniciar Sesión

            a.btn.btn-info.btn-lg(
              href="/posts"
            )
              | Ver Feed General

            a.btn.btn-warning.btn-lg(
              href="/posts/mis-posts"
            )
              | Mis Publicaciones

            a.btn.btn-light.btn-lg(
              href="/usuarios/perfil"
            )
              | Mi Perfil

      .text-center.mt-5

        p.text-muted
          | Proyecto realizado con Node.js, Express, Sequelize y PostgreSQL.

    script(
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
    )