doctype html
html
  head
    title Nueva Publicación - Fotaza2

    link(
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
    )

  body.bg-light

    .container.mt-5

      .row.justify-content-center

        .col-md-8

          .card.shadow

            .card-header.bg-success.text-white

              h2.mb-0 Crear Publicación

            .card-body

              form(
                action="/posts/create"
                method="POST"
                enctype="multipart/form-data"
              )

                .mb-3

                  label.form-label Título

                  input.form-control(
                    type="text"
                    name="titulo"
                    required
                  )

                .mb-3

                  label.form-label Descripción

                  textarea.form-control(
                    name="descripcion"
                    rows="5"
                  )

                .mb-3

                  label.form-label Imagen

                  input.form-control(
                    type="file"
                    name="imagen"
                    accept="image/*"
                  )

                .d-flex.gap-2

                  button.btn.btn-success(
                    type="submit"
                  )
                    | Guardar Publicación

                  a.btn.btn-secondary(
                    href="/posts/mis-posts"
                  )
                    | Cancelar