doctype html
html
  head
    title Nueva Publicación

  body

    h1 Crear Publicación

    form(
      action="/posts/create"
      method="POST"
      enctype="multipart/form-data"
    )

      div
        label Título
        br
        input(type="text" name="titulo" required)

      br

      div
        label Descripción
        br
        textarea(name="descripcion" rows="5")

      br

      div
        label Imagen
        br
        input(
          type="file"
          name="imagen"
          accept="image/*"
        )

      br

      input(
        type="submit"
        value="Guardar Publicación"
      )