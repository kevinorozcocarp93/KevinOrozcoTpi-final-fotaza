doctype html
html
  head
    title Editar Publicación - Fotaza2

    link(
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
    )

  body.bg-light

    .container.mt-5

      .row.justify-content-center

        .col-md-8

          .card.shadow

            .card-header.bg-warning

              h2.mb-0 Editar Publicación

            .card-body

              form(
                action=`/posts/edit/${post.id}`
                method="POST"
              )

                .mb-3

                  label.form-label Título

                  input.form-control(
                    type="text"
                    name="titulo"
                    value=post.titulo
                    required
                  )

                .mb-3

                  label.form-label Descripción

                  textarea.form-control(
                    name="descripcion"
                    rows="5"
                  ) #{post.descripcion}

                .d-flex.gap-2

                  button.btn.btn-warning(
                    type="submit"
                  )
                    | Actualizar

                  a.btn.btn-secondary(
                    href="/posts/mis-posts"
                  )
                    | Cancelar