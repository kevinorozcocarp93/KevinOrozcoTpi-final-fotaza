doctype html
html
  head
    title Editar Publicación

  body

    h1 Editar Publicación

    form(
      action=`/posts/edit/${post.id}`
      method="POST"
    )

      div
        label Título
        br
        input(
          type="text"
          name="titulo"
          value=post.titulo
        )

      br

      div
        label Descripción
        br
        textarea(name="descripcion")
          #{post.descripcion}

      br

      input(
        type="submit"
        value="Actualizar"
      )