doctype html
html
  head
    title Mis Publicaciones

  body

    h1 Mis Publicaciones

    each post in posts

      hr

      h2= post.titulo

      p= post.descripcion

      if post.imagen
        img(
          src=`/uploads/${post.imagen}`
          width="300"
        )

      br

      p
        strong 👍 #{post.Likes ? post.Likes.length : 0} Me gusta

      form(
        action=`/likes/${post.id}`
        method="POST"
      )
        input(
          type="submit"
          value="Dar Like"
        )

      br

      a(href=`/posts/edit/${post.id}`)
        | Editar

      br
      br

      form(
        action=`/posts/delete/${post.id}`
        method="POST"
      )
        input(
          type="submit"
          value="Eliminar"
        )

      br

      form(
        action=`/comments/create/${post.id}`
        method="POST"
      )

        textarea(
          name="contenido"
          rows="3"
          cols="40"
          placeholder="Escribe un comentario..."
          required
        )

        br
        br

        input(
          type="submit"
          value="Comentar"
        )

      br

      h3 Comentarios

      if post.Comments && post.Comments.length > 0

        each comentario in post.Comments

          p
            strong= comentario.User.nombre + ': '
            | #{comentario.contenido}

      else

        p No hay comentarios todavía.

      br
      br