doctype html
html
  head
    title Mis Publicaciones

  body

    h1 Mis Publicaciones

    each post in posts

      hr

      h2= post.titulo

      p= post.descripcion

      if post.imagen

        img(
          src=`/uploads/${post.imagen}`
          width="300"
        )

      br

      p ID: #{post.id}

      a(href=`/posts/edit/${post.id}`) EDITAR PUBLICACION

      hr

      br
      br