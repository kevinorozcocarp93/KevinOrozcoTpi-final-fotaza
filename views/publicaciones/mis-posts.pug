doctype html
html
  head
    title Mis Publicaciones

  body

    h1 Mis Publicaciones

    a(href="/posts/create")
      | ➕ Nueva publicación

    br
    br

    each post in posts

      hr

      h2= post.titulo

      p= post.descripcion

      if post.imagen

        img(
          src=`/uploads/${post.imagen}`
          width="300"
        )

      br
      br

      a(href=`/posts/edit/${post.id}`)
        | ✏️ Editar

      |   

      form(
        action=`/posts/delete/${post.id}`
        method="POST"
        style="display:inline;"
      )

        input(
          type="submit"
          value="🗑️ Eliminar"
        )

      br
      br