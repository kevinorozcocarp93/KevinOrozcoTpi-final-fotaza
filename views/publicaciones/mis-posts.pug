doctype html
html
  head
    title Mis Publicaciones - Fotaza2

    link(
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
    )

  body.bg-light
    include ../partials/navbar
    .container.mt-5.pt-5

      .d-flex.justify-content-between.align-items-center.mb-4

        h1 Mis Publicaciones

        div

          a.btn.btn-primary.me-2(
            href="/posts"
          )
            | Feed General

          a.btn.btn-secondary.me-2(
            href="/perfil"
          )
            | Mi Perfil

          a.btn.btn-danger(
            href="/auth/logout"
          )
            | Cerrar Sesión

      each post in posts

        .card.mb-4.shadow-sm

          .card-body

            h3.card-title= post.titulo

            p.card-text= post.descripcion

            if post.imagen

              img.img-fluid.rounded.mb-3(
                src=`/uploads/${post.imagen}`
              )

            p.fw-bold.text-primary
              | 👍 #{post.Likes ? post.Likes.length : 0} Me gusta

            form(
              action=`/likes/${post.id}`
              method="POST"
            )

              button.btn.btn-primary.mb-3(
                type="submit"
              )
                | Dar Like

            .mb-3

              a.btn.btn-warning.me-2(
                href=`/posts/edit/${post.id}`
              )
                | Editar

              form.d-inline(
                action=`/posts/delete/${post.id}`
                method="POST"
              )

                button.btn.btn-danger(
                  type="submit"
                )
                  | Eliminar

            form(
              action=`/comments/create/${post.id}`
              method="POST"
            )

              .mb-3

                textarea.form-control(
                  name="contenido"
                  rows="3"
                  placeholder="Escribe un comentario..."
                  required
                )

              button.btn.btn-success(
                type="submit"
              )
                | Comentar

            hr

            h5 Comentarios

            if post.Comments && post.Comments.length > 0

              each comentario in post.Comments

                .border.rounded.p-2.mb-2.bg-light

                  strong= comentario.User.nombre + ': '

                  | #{comentario.contenido}

            else

              p.text-muted No hay comentarios todavía.

    script(
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
    )